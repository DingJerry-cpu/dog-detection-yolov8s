# 统一换行，避免 Windows 下反复出现 "LF will be replaced by CRLF"
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.ps1  text eol=crlf
*.cmd  text eol=crlf

# 二进制，别做换行转换
*.jpg  binary
*.jpeg binary
*.png  binary
*.pt   binary
*.npz  binary
*.zip  binary
